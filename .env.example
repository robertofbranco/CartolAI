# Copie este arquivo para .env e preencha com seus tokens.
# .env é ignorado pelo git — não comite tokens.
#
# CARTOLA_TOKEN: X-GLB-Token do globo.com com prefixo "Bearer ".
# Necessário só para escrever ações no Cartola; coleta histórica funciona sem.
CARTOLA_TOKEN=Bearer SEU_TOKEN_AQUI

# GATOMESTRE_TOKEN: Bearer JWT do globo.com (gatomestre.globo.com).
# Necessário para coletar odds. JWT é curto (≈1h) — renove via login no globo.com.
GATOMESTRE_TOKEN=Bearer SEU_TOKEN_AQUI
